<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Lesson_07_Login_register.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="RegisterPage">
    <Grid Margin="10" RowDefinitions="auto,*,auto">
        <Label
            x:Name="lblGlobalMsg"
            BackgroundColor="Beige"
            IsVisible="False"
            Text="xyz" />
        <!--  2. Explicitly put the ScrollView in Row 1 (the '*' row) so it expands and scrolls properly  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="10" Spacing="10">

                <Entry x:Name="entryEmail" Placeholder="Enter your email" />

                <Label
                    x:Name="errEmail"
                    FontSize="Caption"
                    Text=""
                    TextColor="Red" />

                <Entry
                    x:Name="entryPassword"
                    IsPassword="True"
                    Placeholder="Enter your password" />

                <Label
                    x:Name="errPassword"
                    FontSize="Caption"
                    Text=""
                    TextColor="Red" />
                <Entry
                    x:Name="entryPassword"
                    IsPassword="True"
                    Placeholder="Enter your password" />

                <Label
                    x:Name="errPassword"
                    FontSize="Caption"
                    Text=""
                    TextColor="Red" />

            </VerticalStackLayout>
        </ScrollView>
        <Button
            x:Name="btnLogin"
            Grid.Row="2"
            Margin="0,10,0,10"
            BackgroundColor="#2196F3"
            Clicked="btnRegister_Clicked"
            CornerRadius="10"
            FontAttributes="Bold"
            FontSize="18"
            HeightRequest="50"
            Text="Register"
            TextColor="White" />

    </Grid>
</ContentPage>
