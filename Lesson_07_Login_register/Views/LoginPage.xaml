<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Lesson_07_Login_register.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="LoginPage">


    <Grid Margin="10" RowDefinitions="auto,*,auto">
        <Label
            x:Name="lblGlobalMsg"
            BackgroundColor="Beige"
            IsVisible="False"
            Text="xyz" />
        <!--  2. Explicitly put the ScrollView in Row 1 (the '*' row) so it expands and scrolls properly  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="10" Spacing="10">

                <Label Text="Email Address:" />

                <!--  3. Rounded Border Implementation  -->
                <Border
                    Padding="10,0"
                    BackgroundColor="Transparent"
                    Stroke="Gray"
                    StrokeThickness="1">
                    <!--  Padding inside prevents the text from hitting the borders  -->
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                        <!--  Adjust '10' to make it more or less round  -->
                    </Border.StrokeShape>

                    <!--  Hide the default platform border line so it looks clean inside your custom border  -->
                    <Entry x:Name="entryEmail" Placeholder="Enter your email" />
                </Border>

                <Label
                    x:Name="errEmail"
                    FontSize="Caption"
                    Text=""
                    TextColor="Red" />

                <Label Text="Password:" />

                <!--  Another Rounded Border for the Password  -->
                <Border
                    Padding="10,0"
                    Stroke="Gray"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry
                        x:Name="entryPassword"
                        IsPassword="True"
                        Placeholder="Enter your password" />
                </Border>

                <Label
                    x:Name="errPassword"
                    FontSize="Caption"
                    Text=""
                    TextColor="Red" />

            </VerticalStackLayout>
        </ScrollView>
        <Button
            x:Name="btnLogin"
            Grid.Row="2"
            Margin="0,10,0,10"
            BackgroundColor="#2196F3"
            Clicked="btnLogin_Clicked"
            CornerRadius="10"
            FontAttributes="Bold"
            FontSize="18"
            HeightRequest="50"
            Text="Login"
            TextColor="White" />

    </Grid>
</ContentPage>
