<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Lesson_04_ExerciseUIandUIwithCode.Views.CalculateAgePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="CalculateAgePage">
    <Grid
        Margin="10"
        FlowDirection="RightToLeft"
        RowDefinitions="*,*">

        <Label
            x:Name="lblSentence"
            Grid.Row="0"
            HorizontalOptions="Fill"
            Text="ממתין..."
            TextColor="YellowGreen"
            VerticalOptions="Start" />
        <VerticalStackLayout
            Grid.Row="1"
            BackgroundColor="Gray"
            HorizontalOptions="Fill"
            VerticalOptions="End">
            <Label FontSize="Large" Text="שם:" />
            <Entry x:Name="entryName" Keyboard="Numeric" />
            <Label FontSize="Large" Text="גיל:" />
            <Entry x:Name="entryBirthYear" Keyboard="Numeric" />
            <Button Clicked="btnCalculateAge_Clicked" Text="Calculate Age" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
