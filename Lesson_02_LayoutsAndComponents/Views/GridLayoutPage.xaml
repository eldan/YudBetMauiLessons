<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Lesson_02_LayoutsAndComponents.Views.GridLayoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="GridLayoutPage">
    <Grid
        x:Name="gridMain"
        BackgroundColor="DarkBlue"
        ColumnDefinitions="*,*,*"
        RowDefinitions="*,*,*">

        <Label
            Grid.Row="0"
            Grid.Column="1"
            BackgroundColor="Black"
            HorizontalOptions="Center"
            Text="Top" />
        <Label
            Grid.Row="1"
            Grid.Column="0"
            BackgroundColor="Black"
            HorizontalOptions="Start"
            Text="Left"
            VerticalOptions="Center" />
        <Label
            Grid.Row="1"
            Grid.Column="2"
            BackgroundColor="Black"
            HorizontalOptions="End"
            Text="Right"
            VerticalOptions="Center" />
        <Label
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            BackgroundColor="Black"
            HorizontalOptions="Center"
            Text="Bottom" />
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            RowDefinitions="*,*">
            <Button Grid.Row="0" Text="Hi I am a button" />
            <Button Grid.Row="1" Text="Hi I am another button" />
        </Grid>

    </Grid>
</ContentPage>
